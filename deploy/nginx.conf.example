# Replace portfolio.example and certificate paths with your own values.
server {
    listen 80;
    server_name portfolio.example;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name portfolio.example;
    ssl_certificate /etc/letsencrypt/live/portfolio.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portfolio.example/privkey.pem;
    # Requests contain 4 MiB chunks, not the entire uploaded original.
    client_max_body_size 8m;
    location / {
        proxy_pass http://127.0.0.1:18770;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 900s;
    }
}
