---
import '../styles/site.css';
import '../styles/gallery.css';
import '../styles/masonry.css';
import '../styles/photo-flip.css';
import '../styles/public-frame.css';
import '../styles/public-glass.css';
const {page='home'}=Astro.props;
---
<!doctype html>
<html lang="zh-CN">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Photo Atlas：摄影作品、旅行相册与图文随笔"/><title>Photo Atlas</title><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('photo-atlas-theme')||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light')}catch{}</script></head>
<body data-page={page}><a class="skip-link" href="#public-main">跳到主要内容</a>
<div class="site-shell">
<header class="site-header glass"><a class="brand" href="/">Photo Atlas<span>摄影与记录</span></a><nav aria-label="网站导航"><a href="/" data-astro-prefetch data-nav="home">作品</a><a href="/footprints/" data-astro-prefetch data-nav="footprints">足迹</a><a href="/albums/" data-astro-prefetch data-nav="albums">相册</a><a href="/journal/" data-astro-prefetch data-nav="journal">随笔</a><a href="/about/" data-astro-prefetch data-nav="about">关于</a></nav><button class="icon-button" data-theme-toggle aria-label="切换深浅色">◐</button></header>
<main id="public-main"><slot/></main>
<footer class="site-footer"><span data-copyright>© Photo Atlas · 摄影与记录</span><a href="/admin/">管理后台</a></footer>
</div>
<div id="notice" class="notice" role="status" aria-live="polite" hidden></div>
<dialog id="photo-viewer" class="photo-viewer" aria-labelledby="viewer-title"><button id="viewer-prev" class="viewer-step viewer-step-prev" aria-label="上一张作品"><span aria-hidden="true">‹</span></button><button id="viewer-next" class="viewer-step viewer-step-next" aria-label="下一张作品"><span aria-hidden="true">›</span></button><div class="viewer-toolbar"><button class="viewer-close" aria-label="关闭大图">×</button></div><div class="viewer-grid"><div class="viewer-media"><div class="viewer-image-wrap"><img id="viewer-image" alt="" decoding="async" fetchpriority="high"/></div><h2 id="viewer-photo-name" class="viewer-photo-name"></h2><div class="viewer-load"><p id="viewer-status" role="status" aria-live="polite" hidden></p><button id="viewer-retry" class="button subtle" hidden>重新加载大图</button></div><section id="viewer-camera" class="viewer-camera" aria-label="拍摄参数" hidden></section></div><aside><h2 id="viewer-title" class="public-section-title"></h2><p id="viewer-caption"></p><div id="viewer-exif"></div><a id="viewer-link" href="/">作品链接</a></aside></div></dialog>
<script>import '../scripts/public';import {installPublicGlass} from '../scripts/public-glass';installPublicGlass();</script>
</body></html>
