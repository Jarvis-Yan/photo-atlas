.featured-cover{margin-top:24rpx}
.featured-frame{position:relative;background:#15243a;overflow:hidden}
.featured-swiper{width:100%;height:480rpx}
.featured-slide{height:100%;display:flex;align-items:center;justify-content:center}
.featured-card{flex-shrink:0;transform-origin:50% 50%;transition:transform .5s ease,opacity .5s ease}
.featured-card.center{transform:translateY(0) rotate(0);opacity:1}
.featured-card.before{transform:translateY(32rpx) rotate(-12deg) scale(.94);opacity:.82}
.featured-card.after{transform:translateY(32rpx) rotate(12deg) scale(.94);opacity:.82}
.featured-caption{padding-top:12rpx;text-align:center;color:#edf1f7;height:32rpx;line-height:32rpx}
.featured-title{display:block;font-size:22rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.featured-controls{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding-top:8rpx}
.featured-hint{color:#b3c2d7;font-size:20rpx}
.featured-navigation{display:flex;align-items:center;gap:12rpx;flex-shrink:0}
.featured-arrow{width:88rpx;height:88rpx;min-height:44px;min-width:44px;padding:0;margin:0;border:1rpx solid rgba(255,255,255,.2);border-radius:50%;background:transparent;color:#edf1f7;line-height:88rpx;font-size:36rpx}
.featured-arrow:after{border:0}
.featured-count{color:#b3c2d7;text-align:center;font-size:22rpx;min-width:76rpx;font-variant-numeric:tabular-nums}
