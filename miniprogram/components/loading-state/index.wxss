.state{padding:58rpx 28rpx;text-align:center;color:var(--muted)}.retry{display:inline-flex;margin-top:22rpx;padding:12rpx 22rpx;border:0;border-radius:16rpx;background:var(--soft);color:var(--blue-strong);font-size:24rpx}.retry::after{border:0}

.skeleton{display:flex;flex-direction:column;gap:14rpx;margin-bottom:24rpx}.skeleton-line{height:18rpx;border-radius:9rpx;background:var(--soft)}.skeleton-line.medium{width:80%}.skeleton-line.short{width:60%}
