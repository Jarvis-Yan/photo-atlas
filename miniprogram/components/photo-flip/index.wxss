.photo-flip{position:relative;width:100%;perspective:1600rpx}.flip-turn{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform 520ms cubic-bezier(.22,.7,.2,1)}.is-flipped .flip-turn{transform:rotateY(180deg)}.is-turning .flip-turn{will-change:transform}.flip-front,.flip-back{position:absolute;inset:0;overflow:hidden;border-radius:20rpx;backface-visibility:hidden;-webkit-backface-visibility:hidden}.flip-front{background:var(--soft,#e5ecf5);transform:translateZ(1px)}.flip-back{background:#15243a;transform:rotateY(180deg) translateZ(1px);color:#edf1f7;pointer-events:none}.is-flipped .flip-back{pointer-events:auto}.is-flipped .flip-front{pointer-events:none}.flip-background{position:absolute;inset:-24rpx;width:calc(100% + 48rpx);height:calc(100% + 48rpx);transform:scaleX(-1);filter:blur(18rpx) brightness(.7) saturate(.85);pointer-events:none}.flip-shade{position:absolute;inset:0;background:linear-gradient(145deg,rgba(16,30,49,.18),rgba(7,16,29,.65));pointer-events:none}.flip-copy{position:relative;box-sizing:border-box;min-height:100%;padding:38rpx;display:flex;flex-direction:column;align-items:flex-start;gap:18rpx;overflow-wrap:anywhere}.flip-title{font-size:42rpx;line-height:1.25;font-weight:550}.flip-meta,.flip-caption,.flip-tags{font-size:32rpx;line-height:1.65;color:#e1e8f1}.flip-caption{white-space:pre-wrap}.flip-glass{position:relative;margin:18rpx 0 0;padding:18rpx 28rpx;min-height:88rpx;border:1rpx solid rgba(255,255,255,.48);border-radius:20rpx;background:linear-gradient(135deg,rgba(255,255,255,.22),rgba(255,255,255,.07));backdrop-filter:blur(18rpx) saturate(1.1);-webkit-backdrop-filter:blur(18rpx) saturate(1.1);box-shadow:inset 0 2rpx 2rpx rgba(255,255,255,.32),inset 0 -2rpx 3rpx rgba(8,20,36,.18),0 6rpx 20rpx rgba(0,0,0,.12);color:#fff;font-size:32rpx;line-height:1.4;transition:transform 180ms}.flip-glass::after{border:0}.glass-pressed{transform:scale(1.035);background:linear-gradient(135deg,rgba(255,255,255,.28),rgba(255,255,255,.08))}@media(prefers-reduced-motion:reduce){.flip-turn,.flip-glass{transition:none}}

/* Light sits above the already blurred mirror, including inside the glass control. */
.flip-light{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 45% 40%,rgba(255,255,255,.13),transparent 70%);opacity:0;transition:opacity 220ms ease}.is-lit .flip-light{opacity:1}.flip-glass{border-color:rgba(255,255,255,.3);background:linear-gradient(130deg,rgba(255,255,255,.2),rgba(255,255,255,.045) 55%,rgba(255,255,255,.12));box-shadow:inset 0 2rpx 1rpx rgba(255,255,255,.5),inset 0 -2rpx 2rpx rgba(255,255,255,.1),0 8rpx 26rpx rgba(3,10,20,.16);backdrop-filter:blur(22rpx) saturate(1.18);-webkit-backdrop-filter:blur(22rpx) saturate(1.18);transition:transform 180ms cubic-bezier(.2,.8,.2,1),background 180ms}.flip-glass::after{inset:2rpx;border:1rpx solid rgba(255,255,255,.12);border-radius:18rpx;pointer-events:none}@media(hover:hover){.photo-flip:hover .flip-light{opacity:1}.flip-glass:hover{transform:scale(1.035)}}@media(prefers-reduced-motion:reduce){.flip-light{transition:none}}

.flip-exif{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24rpx 28rpx;width:100%;margin-top:10rpx}.flip-fact{min-width:0}.flip-fact-label{font-size:25rpx;line-height:1.5;color:#bacbdf}.flip-fact-value{font-size:30rpx;line-height:1.55;margin-top:6rpx;overflow-wrap:anywhere;color:#edf3fa}

.flip-actions{display:flex;flex-wrap:wrap;gap:18rpx;align-items:center;width:100%}.flip-actions .flip-glass{margin-top:18rpx;flex:0 1 auto}.flip-glass.is-saving{opacity:.65;color:#fff}

.flip-actions{gap:20rpx}.flip-actions .flip-glass{display:flex;align-items:center;justify-content:center;min-height:88rpx;padding:18rpx 26rpx;line-height:1.4;white-space:nowrap}

.flip-copy{padding:26rpx;gap:12rpx}.flip-title{font-size:38rpx;line-height:1.3}.flip-meta,.flip-caption,.flip-tags{font-size:28rpx;line-height:1.5}.flip-actions{gap:18rpx;flex-wrap:nowrap;margin-top:auto}.flip-actions .flip-glass{font-size:26rpx;min-height:64rpx;padding:12rpx 20rpx;margin-top:10rpx;line-height:1.3;border-radius:40rpx}
