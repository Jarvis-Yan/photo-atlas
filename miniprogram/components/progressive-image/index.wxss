:host{display:block;width:100%}.progressive-frame{position:relative;width:100%;overflow:hidden;background:var(--soft,transparent)}.progressive-layer{position:absolute;inset:0;width:100%;height:100%;display:block;opacity:0}.progressive-layer.ready{opacity:1}.progressive-retry{position:absolute;z-index:2;right:8rpx;bottom:8rpx;margin:0;padding:8rpx 16rpx;min-height:72rpx;line-height:1.5;border:0;border-radius:0;background:var(--surface,#edf1f7);color:var(--text,#15243a);font-size:22rpx}.progressive-retry::after{border:0}
