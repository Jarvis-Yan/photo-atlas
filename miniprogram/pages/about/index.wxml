<view class="page {{theme}}"><view class="about-hero"><view class="heading">关于 {{settings.site_name || 'PixelCore'}}</view><loading-state loading="{{loading}}" error="{{error}}" bind:retry="load"/><view wx:if="{{!loading&&!error}}"><text class="about-copy" user-select>{{settings.about}}</text><view class="actions"><button class="button" bindtap="openAlbums">浏览相册 ↗</button><button class="button subtle" bindtap="openFootprints">摄影足迹 →</button></view><view wx:if="{{album.cover}}" class="about-work" bindtap="openWork"><progressive-image photo="{{album.cover}}" height="{{album.cover.fullCardHeight*606/686+'rpx'}}" clear-size="1600"/><view>{{album.cover.title}} · {{album.cover.locationText}}</view></view></view></view><view class="about-details" wx:if="{{!loading&&!error}}"><view class="section-title">联系我</view><view class="section-copy">关于作品与拍摄，可以通过以下方式联系。</view><view class="contact" wx:if="{{settings.contact}}" bindtap="copyContact"><text>{{settings.contact}}</text><text class="copy">复制</text></view><view class="actions"><button class="button subtle" bindtap="toggleTheme">切换{{theme==='dark'?'浅色':'深色'}}主题</button><button class="button subtle" open-type="share">分享小程序</button></view></view><view class="copyright">{{settings.copyright}}</view></view>