.heading{margin-bottom:34rpx}.about{padding:38rpx 34rpx}.about-copy{display:block;white-space:pre-wrap;color:var(--text);font-size:29rpx}.contact{display:flex;justify-content:space-between;gap:24rpx;margin-top:30rpx;padding:22rpx 0;border-top:1rpx solid var(--border);color:var(--muted)}.copy{color:var(--blue-strong)}.actions{margin-top:30rpx}.copyright{text-align:center;color:var(--muted);font-size:22rpx;margin-top:38rpx}

.about-hero{background:#15243a;color:#edf1f7;padding:40rpx;margin-bottom:72rpx}.about-hero .heading{color:#edf1f7}.about-copy{color:#d5dfed;font-size:34rpx;line-height:1.8}.about-hero .actions{margin-top:36rpx}.about-hero .button{background:#edf1f7;color:#15243a;border:0}.about-hero .button.subtle{background:transparent;color:#b5e4fa}.about-work{margin-top:48rpx;font-size:23rpx;color:#b3c2d7}.about-work image{display:block;width:100%;margin-bottom:16rpx}.section-title{font-size:52rpx;font-weight:550}.contact{border:0;font-size:30rpx;word-break:break-all}.copyright{text-align:left}.about-hero .actions .button{flex:1 1 220rpx}
