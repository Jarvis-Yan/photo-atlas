<view class="page {{theme}}"><view wx:if="{{album}}" class="album-heading"><view class="heading">{{album.title}}</view><view class="section-copy" wx:if="{{album.placeText}}">{{album.placeText}}</view><view class="section-copy" wx:if="{{album.description}}">{{album.description}}</view><view class="count">{{album.yearText ? album.yearText+' · ' : ''}}{{total}} 张作品</view></view><loading-state loading="{{loading}}" error="{{error}}" bind:retry="load"/><photo-waterfall id="photo-gallery" flip layout-mode="{{total<=12?'bounded':'masonry'}}" show-controls="{{false}}" wx:if="{{!loading && photos.length}}" photos="{{photos}}" active="{{galleryActive}}" bind:open="openPhoto"/><button class="button subtle load-more" wx:if="{{photos.length<total}}" loading="{{loadingMore}}" bindtap="loadMore">更多作品</button></view>
