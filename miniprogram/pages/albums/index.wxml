<view class="page {{theme}}"><view class="heading">相册</view><view class="section-copy intro">按地点、项目与专题，收藏每一段影像。</view><view class="album-types"><view wx:for="{{kinds}}" wx:key="value" class="tag {{kind===item.value?'active':''}}" data-kind="{{item.value}}" bindtap="chooseKind">{{item.label}}</view></view><loading-state loading="{{loading}}" error="{{error}}" empty="{{!loading&&!error&&!albums.length?'暂无公开相册。':''}}" bind:retry="load"/><view class="album-list"><view class="card album" wx:for="{{albums}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><progressive-image wx:if="{{item.cover}}" class="cover" photo="{{item.cover}}" height="{{item.cover.fullCardHeight+'rpx'}}" clear-size="1600" priority="{{index<2}}"/><view class="card-copy"><view class="card-title">{{item.title}}</view><view class="album-places" wx:if="{{item.placeText}}">{{item.placeText}}</view><view class="description" wx:if="{{item.description}}">{{item.description}}</view><view class="card-meta">{{item.yearText ? item.yearText+' · ' : ''}}{{item.count ? item.count+' 张作品' : '暂无公开作品'}}</view></view></view></view></view>
