.intro{margin-bottom:34rpx}.album-list{display:flex;flex-direction:column;gap:28rpx}.cover,.placeholder{height:420rpx}.placeholder{display:flex;align-items:center;justify-content:center;background:var(--soft);color:var(--muted)}.description{font-size:25rpx;color:var(--muted);margin-top:12rpx;white-space:pre-wrap}

.album-list{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20rpx}.album-types{display:flex;gap:10rpx;margin:24rpx 0;justify-content:space-between}.album-types .tag{padding:10rpx 18rpx;font-size:22rpx}.cover,.placeholder{height:242rpx}.card-title{font-size:27rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.card-copy{padding:20rpx;min-height:176rpx;box-sizing:border-box}.description{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:22rpx;line-height:1.5;min-height:66rpx;margin-top:8rpx}.card-meta{font-size:20rpx}

.album-list{gap:32rpx 22rpx}.card-copy{padding:18rpx 0 24rpx;border-bottom:1rpx solid var(--border)}.cover,.placeholder{height:260rpx}.description{font-size:21rpx}.album-types .tag{padding:12rpx 6rpx}

.album-list{display:block}.album-list .album{margin-bottom:64rpx}.cover{height:auto;background:transparent}.card-copy{padding:24rpx 0 0;min-height:0;border:0}.card-title{font-size:46rpx;white-space:normal}.description{min-height:0;font-size:26rpx}.album-places{font-size:26rpx;color:var(--muted);margin-top:10rpx}.card-meta{font-size:26rpx}.album-types{justify-content:flex-start;flex-wrap:wrap;gap:10rpx 28rpx}.album-types .tag{font-size:26rpx;min-height:88rpx}
