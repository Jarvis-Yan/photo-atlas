.atlas{padding:0;overflow:hidden;position:relative;min-height:0}.atlas-fixed{padding:20rpx 88rpx 0 32rpx;box-sizing:border-box}.atlas-title{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;margin-bottom:16rpx}.atlas-title>text:first-child{font-size:48rpx;font-weight:550;line-height:1.25}.atlas-title>text:last-child{font-size:22rpx;color:var(--muted)}.map-frame{color:var(--text)}.map{width:100%;height:180px}.map-context{height:88rpx;display:flex;flex-direction:column;justify-content:center;overflow:hidden;padding-top:8rpx;box-sizing:border-box}.map-context>text:first-child{font-size:28rpx;font-weight:550;line-height:1.2}.map-context>text:last-child{font-size:21rpx;line-height:1.4;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.map-note{font-size:19rpx;color:var(--muted);padding-top:10rpx}.story-content{padding:24rpx 88rpx 64rpx 32rpx;box-sizing:border-box}.filters{display:flex;gap:16rpx;flex-wrap:wrap;align-items:center;margin-bottom:28rpx}.place-select{min-width:0;flex:1;padding:18rpx 16rpx;background:var(--surface);font-size:28rpx}.place-select view{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.filters .input{width:100%;font-size:32rpx}.text-button{margin:0;padding:16rpx 4rpx;min-height:88rpx;border:0;background:transparent;color:var(--blue-strong);font-size:26rpx;text-align:left;line-height:1.6}.text-button::after{border:0}.advanced{padding:24rpx;background:var(--soft);margin-bottom:32rpx}.picker{font-size:28rpx;padding:12rpx 0}.advanced label{display:flex;align-items:center;font-size:24rpx}.year-range>text{font-size:24rpx}.calendar{margin-bottom:64rpx}.calendar-heading{display:flex;align-items:baseline;gap:16rpx;margin:28rpx 0}.calendar-heading>text:first-child{font-size:40rpx;font-weight:550}.calendar-heading>text:last-child{font-size:22rpx;color:var(--muted)}.grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:36rpx 24rpx;align-items:start}.timeline-photo.full{grid-column:1/-1}.timeline-photo{min-width:0}.timeline-photo image{width:100%;display:block;background:var(--soft)}.photo-title{font-size:26rpx;margin-top:14rpx}.photo-location{font-size:21rpx;color:var(--muted);margin-top:6rpx;overflow-wrap:anywhere}.time-rail{position:absolute;right:0;width:88rpx;z-index:8;touch-action:none}.time-tick{position:absolute;right:16rpx;height:2rpx;transform:translateY(-50%);background:var(--text);opacity:.24;pointer-events:none}.time-tick.active{height:6rpx;opacity:1}.time-label{position:absolute;right:16rpx;top:100%;font-size:18rpx;color:var(--muted);white-space:nowrap;padding-top:20rpx;pointer-events:none}.timeline-scroll{overflow-anchor:none}.empty{padding:40rpx 0;text-align:left}

.time-label{margin:0;min-height:88rpx;right:0;width:88rpx;padding:12rpx 0;font-size:20rpx;line-height:1.4;background:transparent;border:0;pointer-events:auto}.time-label::after{border:0}

.time-label{z-index:10}

.time-current{position:absolute;right:100rpx;z-index:9;transform:translateY(-50%);padding:8rpx 12rpx;max-width:440rpx;background:#15243a;color:#edf1f7;font-size:22rpx;line-height:1.4;white-space:nowrap;pointer-events:none;font-variant-numeric:tabular-nums}

.visit-heading{display:flex;flex-direction:column;gap:6rpx;min-width:0}.calendar-heading .visit-place{font-size:26rpx;font-weight:400;line-height:1.4;color:var(--muted);overflow-wrap:anywhere}
