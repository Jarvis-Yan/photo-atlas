.hero{padding:48rpx 38rpx;margin-bottom:44rpx}.hero-title{font-size:50rpx;font-weight:680;line-height:1.25;color:var(--blue-strong)}.hero-copy{color:var(--muted);margin-top:18rpx}.hero .actions{margin-top:34rpx}.search{margin-bottom:22rpx}.category-scroll{width:100%;margin-bottom:28rpx}.categories{display:inline-flex;gap:14rpx;padding:2rpx 2rpx 8rpx}.more{color:var(--blue-strong);font-size:24rpx}.post-list{display:flex;flex-direction:column;gap:20rpx}.post-card{padding:32rpx}.post-copy{font-size:26rpx;color:var(--muted);margin-top:16rpx}.post-card .card-meta{margin-top:22rpx}

.hero{padding:36rpx 30rpx;margin-bottom:34rpx}.hero-title{font-size:44rpx;line-height:1.3;max-width:14em}.hero .eyebrow{font-size:18rpx;letter-spacing:2rpx;margin-bottom:18rpx}.hero .actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:28rpx}.hero .button{width:100%;padding:16rpx 10rpx;margin:0}.section-heading{margin-top:32rpx}.categories{gap:12rpx}.section-copy{line-height:1.6}

.hero{padding:14rpx 0 34rpx;margin-bottom:36rpx;border:0;border-bottom:1rpx solid var(--border);background:transparent}.hero-title{font-size:54rpx;font-weight:550;color:var(--text);letter-spacing:-1rpx;line-height:1.2;max-width:11em}.hero-copy{font-size:25rpx;line-height:1.8;margin-top:22rpx}.hero .eyebrow{font-size:17rpx;letter-spacing:2rpx}.hero .actions{margin-top:28rpx}.hero .button{font-size:24rpx;min-height:78rpx}.section-heading .heading{font-size:38rpx;font-weight:550}.categories{gap:28rpx}.section-heading{margin-top:22rpx}.more{color:var(--text)}.post-card{border-width:1rpx 0 0;border-radius:0;padding:28rpx 0;background:transparent}.edition{display:flex;justify-content:space-between;color:var(--muted);font-size:17rpx;letter-spacing:2rpx;margin-bottom:12rpx}

.hero{background:#15243a;padding:32rpx 28rpx;border:0;border-radius:8rpx}.hero-title{color:#edf1f7;font-size:50rpx}.hero .eyebrow{color:#8ccff2}.hero-copy{color:#b3c2d7}.hero .button.primary{background:#edf1f7;color:#15243a;border-color:#edf1f7}.hero .button.subtle{background:transparent;color:#edf1f7;border-color:#6a7b92}

.hero-title{font-size:68rpx;line-height:1.15}.hero-copy{font-size:28rpx}.categories{display:flex;flex-wrap:wrap;gap:12rpx 32rpx;margin-bottom:32rpx}.tag{min-height:88rpx}.scope{display:inline-flex;background:var(--soft);padding:8rpx;margin:8rpx 0 18rpx;gap:8rpx}.scope-button{margin:0;border:0;border-radius:0;background:transparent;color:var(--text);font-size:28rpx;min-height:88rpx;padding:12rpx 32rpx}.scope-button::after{border:0}.scope-button.selected{background:#15243a;color:#edf1f7}.dark .scope-button.selected{background:#b5e4fa;color:#15243a}.collection-count{font-size:26rpx;color:var(--muted);margin-bottom:22rpx}.empty .button{margin-top:24rpx;margin-right:12rpx}

.section-heading{display:flex;justify-content:space-between;gap:20rpx;align-items:center}.collection-tools{display:flex;flex-shrink:0;gap:24rpx}.collection-tools button,.journey-link{margin:0;padding:12rpx 0;min-height:88rpx;border:0;background:transparent;color:var(--blue-strong);font-size:26rpx;line-height:64rpx}.collection-tools button::after,.journey-link::after{border:0}.browse-options{padding:24rpx;background:var(--soft);margin:0 0 24rpx;font-size:24rpx;color:var(--muted)}.browse-options .button{margin-top:20rpx}.home-journey{margin-top:72rpx;padding-top:32rpx;border-top:1rpx solid var(--border)}.home-journey .heading{font-size:44rpx;font-weight:550;line-height:1.3}.journey-date{color:var(--muted);font-size:24rpx;margin-top:12rpx}.journey-link{text-align:left}.journey-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:32rpx 20rpx;margin:20rpx 0}.journey-photo.full{grid-column:1/-1}.journey-photo{min-width:0;font-size:24rpx}.journey-photo image{width:100%;display:block;background:var(--soft);margin-bottom:12rpx}

.collection-load-status{padding:32rpx 0;min-height:64rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx;color:var(--muted)}

.collection-results{min-height:calc(100vh - 280rpx)}

.collection-bridge{margin-top:56rpx;border-top:1rpx solid var(--border);padding:40rpx 0 52rpx;display:grid;grid-template-columns:1fr auto;align-items:center;gap:28rpx;min-height:240rpx;box-sizing:border-box}.bridge-meta{grid-column:1/-1;display:flex;justify-content:space-between;color:var(--muted);font-size:24rpx;font-variant-numeric:tabular-nums}.bridge-title{font-size:42rpx;font-weight:500;letter-spacing:2rpx}.bridge-track{width:164rpx;height:4rpx;margin-top:26rpx;background:var(--border);overflow:hidden;border-radius:4rpx}.bridge-track-fill{width:100%;height:100%;background:var(--blue);transform:scaleX(0);transform-origin:left;transition:transform 180ms cubic-bezier(.22,1,.36,1)}.bridge-mark{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;border-radius:50%;border:1rpx solid var(--border);background:var(--soft);color:var(--blue);font-size:38rpx;transition:transform 420ms cubic-bezier(.22,1,.36,1)}.collection-complete{grid-column:1/-1;text-align:center;font-size:26rpx;color:var(--muted)}.is-loading .bridge-track-fill{animation:bridge-loading 1.2s ease-in-out infinite;transform-origin:center}@keyframes bridge-loading{0%,100%{transform:translateX(-85%) scaleX(.3)}50%{transform:translateX(85%) scaleX(.3)}}@media(prefers-reduced-motion:reduce){.bridge-mark,.bridge-track-fill{transition:none}.is-loading .bridge-track-fill{animation:none}}

/* Keep page-specific legacy styles from flattening the shared glass controls. */
.hero .button,.scope-button,.collection-tools button,.journey-link{border:1rpx solid rgba(119,144,174,.26);border-radius:18rpx;background:linear-gradient(135deg,rgba(255,255,255,.6),rgba(226,237,249,.32));box-shadow:inset 0 2rpx 1rpx rgba(255,255,255,.8),inset 0 -2rpx 2rpx rgba(56,86,121,.08),0 4rpx 14rpx rgba(21,36,58,.04);backdrop-filter:blur(20rpx) saturate(1.15);-webkit-backdrop-filter:blur(20rpx) saturate(1.15);transition:transform 180ms cubic-bezier(.2,.8,.2,1)}.hero .button.primary{background:linear-gradient(135deg,rgba(255,255,255,.92),rgba(222,237,250,.68));border-color:rgba(255,255,255,.65)}.hero .button.subtle{background:linear-gradient(135deg,rgba(255,255,255,.16),rgba(255,255,255,.035));border-color:rgba(255,255,255,.3);box-shadow:inset 0 2rpx 1rpx rgba(255,255,255,.25),0 4rpx 14rpx rgba(0,0,0,.08)}.scope{background:transparent;padding:0;gap:14rpx}.scope-button.selected{background:linear-gradient(135deg,#34475e,#15243a);box-shadow:inset 0 2rpx 1rpx rgba(255,255,255,.25),0 4rpx 14rpx rgba(21,36,58,.12)}.collection-tools{gap:12rpx}.collection-tools button{padding:6rpx 20rpx;min-height:76rpx}.journey-link{padding:8rpx 22rpx;margin-top:14rpx;display:inline-block}.hero .button.glass-touch,.scope-button.glass-touch,.collection-tools button.glass-touch,.journey-link.glass-touch{transform:scale(1.035)}.dark .scope-button,.dark .collection-tools button,.dark .journey-link{background:linear-gradient(135deg,rgba(255,255,255,.14),rgba(255,255,255,.035));border-color:rgba(255,255,255,.22)}.dark .scope-button.selected{background:linear-gradient(135deg,#c9e9f9,#92bfd7);color:#15243a}.bridge-track{width:220rpx;height:6rpx}.bridge-mark{background:linear-gradient(135deg,rgba(255,255,255,.5),rgba(184,211,236,.18));box-shadow:inset 0 2rpx 1rpx rgba(255,255,255,.65);backdrop-filter:blur(16rpx);-webkit-backdrop-filter:blur(16rpx)}
