function surface(owner){return owner.selectComponent('.home-touch-surface');}
function read(event){var bits=(event.currentTarget.dataset.pullConfig||'0:false:false').split(':');return {revision:bits[0],enabled:bits[1]=='true',near:bits[2]=='true'};}
function style(owner,selector,value){var node=owner.selectComponent(selector);if(node)node.setStyle(value);}
function paint(owner,distance,tracking){
 var progress=Math.min(1,Math.max(0,distance/90));
 var lift=36*(1-1/(1+Math.max(0,distance)/90));
 var spring=tracking?'none':'transform 480ms cubic-bezier(.16,1,.3,1)';
 style(owner,'.bridge-track-fill',{'transform':'scaleX('+progress+')','transition':tracking?'none':'transform 300ms ease-out'});
 style(owner,'.bridge-mark',{'transform':'translate3d(0,'+(-lift*0.35)+'px,0) scale('+(1+progress*0.08)+')','transition':spring});
 style(owner,'.collection-results',{'transform':'translate3d(0,'+(-lift)+'px,0)','transition':spring});
}
function start(event,owner){
 var state=surface(owner).getState(),config=read(event);
 state.touching=event.touches.length==1;state.cancelled=false;state.distance=0;state.revision=config.revision;
 // The gesture that arrives at the boundary starts outside it, so cannot load.
 state.allow=state.touching&&config.enabled&&config.near;
 if(state.touching){state.startY=event.touches[0].clientY;state.lastY=state.startY;}
 paint(owner,0,false);
}
function move(event,owner){
 var state=surface(owner).getState();
 if(!state.touching||!state.allow||state.cancelled)return;
 if(event.touches.length!=1){cancel(event,owner);return;}
 var y=event.touches[0].clientY;
 if(y>state.lastY){state.cancelled=true;state.allow=false;state.distance=0;paint(owner,0,false);return;}
 state.lastY=y;state.distance=Math.max(0,state.startY-y);paint(owner,state.distance,true);
}
function end(event,owner){
 var state=surface(owner).getState(),config=read(event);
 var commit=state.touching&&state.allow&&!state.cancelled&&config.enabled&&config.near&&config.revision==state.revision&&state.distance>=90;
 state.touching=false;state.allow=false;state.distance=0;paint(owner,0,false);
 if(commit)owner.callMethod('commitPull',{count:state.revision*1});
}
function cancel(event,owner){var state=surface(owner).getState();state.cancelled=true;state.touching=false;state.allow=false;state.distance=0;paint(owner,0,false);}
module.exports={start:start,move:move,end:end,cancel:cancel};
