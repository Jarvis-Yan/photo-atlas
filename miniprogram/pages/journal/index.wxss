.intro{margin-bottom:34rpx}.post-list{display:flex;flex-direction:column;gap:24rpx}.post{padding:36rpx 32rpx}.excerpt{font-size:26rpx;color:var(--muted);margin-top:16rpx;white-space:pre-wrap}.post .card-meta{margin-top:25rpx}

