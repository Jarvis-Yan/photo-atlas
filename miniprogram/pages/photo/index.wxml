<view class="page {{theme}} {{viewer?'camera-viewer':''}}"><view class="status glass" wx:if="{{loading}}">正在加载照片…</view><view class="status glass" wx:elif="{{error}}">{{error}}</view><view wx:elif="{{photo}}"><view wx:if="{{viewer}}" class="large-photo"><progressive-image photo="{{photo}}" height="{{photo.fullCardHeight+'rpx'}}" clear-size="2400" priority interactive bindtap="preview"/><view wx:if="{{photo.exifList.length}}" class="camera-footer"><view class="exif"><view class="exif-row" wx:for="{{photo.exifList}}" wx:key="label"><text>{{item.label}}</text><text>{{item.value}}</text></view></view></view></view><view wx:else class="photo glass"><progressive-image class="detail-image" photo="{{photo}}" height="{{photo.fullCardHeight+'rpx'}}" clear-size="2400" priority interactive bindtap="preview"/><view class="detail-copy"><view class="eyebrow">PHOTOGRAPH</view><view class="title">{{photo.title}}</view><view class="caption" wx:if="{{photo.caption}}" user-select>{{photo.caption}}</view><view class="location" wx:if="{{photo.locationText}}">{{photo.locationText}}</view><view class="exif"><view class="exif-row" wx:for="{{photo.exifList}}" wx:key="label"><text>{{item.label}}</text><text>{{item.value}}</text></view></view><view class="dimensions">{{photo.width}} × {{photo.height}}</view><view class="actions"><button class="button primary" bindtap="preview">查看大图</button><button class="button subtle" wx:if="{{photo.download}}" loading="{{saving}}" bindtap="save">保存高清预览</button><button class="button subtle" open-type="share">分享</button></view></view></view></view></view>
