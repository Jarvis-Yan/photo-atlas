.photo{overflow:hidden}.detail-image{display:block;width:100%;background:var(--soft)}.detail-copy{padding:36rpx 32rpx}.title{font-size:43rpx;font-weight:650;line-height:1.3}.caption{white-space:pre-wrap;color:var(--muted);margin-top:22rpx}.location{color:var(--muted);font-size:23rpx;margin-top:18rpx}.exif{display:grid;grid-template-columns:1fr 1fr;gap:22rpx;margin:34rpx 0}.exif-row{display:flex;flex-direction:column}.exif-row text:first-child{font-size:20rpx;color:var(--muted)}.exif-row text:last-child{font-size:25rpx;color:var(--text);word-break:break-all}.dimensions{font-size:22rpx;color:var(--muted);margin-bottom:30rpx}

.camera-viewer{min-height:100vh;background:#0d1928;color:#e8eef7;padding-bottom:48rpx}.large-photo{width:100%}.camera-footer{margin:32rpx 0 0;padding:32rpx 8rpx 0;border-top:1rpx solid #ffffff24}.camera-footer .exif{gap:28rpx 30rpx;margin:0}.camera-footer .exif-row text:first-child{font-size:25rpx;color:#aebfd2}.camera-footer .exif-row text:last-child{font-size:30rpx;color:#e8eef7;word-break:normal;overflow-wrap:anywhere;margin-top:6rpx}
