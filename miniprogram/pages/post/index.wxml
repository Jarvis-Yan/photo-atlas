<view class="page {{theme}}"><view class="status glass" wx:if="{{loading}}">正在加载随笔…</view><view class="status glass" wx:elif="{{error}}">{{error}}</view><view class="article glass" wx:elif="{{post}}"><view class="eyebrow">JOURNAL</view><view class="title">{{post.title}}</view><view class="date">{{post.dateText}}</view><rich-text class="rich" nodes="{{post.html}}" user-select></rich-text><button class="button subtle share" open-type="share">分享这篇随笔</button></view></view>
