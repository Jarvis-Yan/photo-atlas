{
  "appid": "touristappid",
  "projectname": "pixelcore-miniprogram",
  "description": "PixelCore 摄影与记录微信小程序",
  "miniprogramRoot": "./",
  "compileType": "miniprogram",
  "libVersion": "latest",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "coverView": true,
    "showShadowRootInWxmlPanel": true,
    "packNpmManually": false,
    "compileWorklet": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "disableUseStrict": false,
    "useCompilerPlugins": false,
    "condition": false,
    "swc": false,
    "disableSWC": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "condition": {},
  "simulatorPluginLibVersion": {},
  "packOptions": {
    "ignore": [
      {
        "value": "tests",
        "type": "folder"
      },
      {
        "value": "scripts",
        "type": "folder"
      },
      {
        "value": "README.md",
        "type": "file"
      },
      {
        "value": "config.example.js",
        "type": "folder"
      },
      {
        "value": "project.private.config.json",
        "type": "file"
      }
    ],
    "include": []
  },
  "editorSetting": {}
}
